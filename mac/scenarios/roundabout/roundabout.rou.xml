    <route id="ES" edges="E_in circ_EN circ_NW circ_WS S_out"/>
    <route id="NE" edges="N_in circ_NW circ_WS circ_SE E_out"/>
    <route id="SW" edges="S_in circ_SE circ_EN circ_NW W_out"/>
